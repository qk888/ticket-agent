# ─────────────────────────────────────────────────────────────
# ticket-agent 环境变量
# 复制为 .env 后填写。所有项都有默认值，除 API Key 外都能空跑。
#
# ★ 模型端点有两种配法，**选一种**即可：
#     A. 简单：只填下面的 OPENAI_* 三条（老路径，等价于 deepseek 档案）
#     B. 多端点：填 LLM_PROFILE=档案名，再按需覆盖（见下面"多端点"段）
#   两种配法等价时结果相同 —— 它们走的是同一份解析实现
#   （`config._resolve_endpoint`），这一点由 tests/test_endpoints.py 里的
#   `test_both_entry_points_agree` 盯着。
# ─────────────────────────────────────────────────────────────

# ── 模型（OpenAI 兼容端点）──────────────────────────────────
# DeepSeek:  https://api.deepseek.com/v1        model=deepseek-chat
# 通义:      https://dashscope.aliyuncs.com/compatible-mode/v1   model=qwen-plus
# Ollama:    http://localhost:11434/v1          model=qwen2.5:7b    （成本 0）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com/v1
MODEL_NAME=deepseek-chat
# 便宜模型：成本熔断触发后降级到这里
CHEAP_MODEL_NAME=deepseek-chat
TEMPERATURE=0

# ── 多端点（可留空整段，不影响上面的老路径）──────────────────
# 端点档案：deepseek | hunyuan | hy3 | ollama | openai | relay | custom
# 留空 = 走上面的 OPENAI_* 老路径。填了才启用档案。
# 用 `python -m ticket_agent.cli endpoint --list` 看每个档案的默认值与说明。
# LLM_PROFILE=

# 显式覆盖（留空则取档案里的值）。键名与 `endpoint --base-url/--model` 对应。
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_CHEAP_MODEL=

# ★ Key 的三种放法，优先级从高到低：
#     1. LLM_API_KEY（通用）
#     2. 档案专用变量（hunyuan → HUNYUAN_API_KEY、relay → RELAY_API_KEY、
#        deepseek → DEEPSEEK_API_KEY、openai → OPENAI_OFFICIAL_API_KEY、
#        hy3 → WORKBUDDY_SIDECAR_TOKEN）
#     3. OPENAI_API_KEY（老路径）
#   ★ 档案专用变量**排在通用 LLM_API_KEY 之前**："更具体的选择优先"。
#     否则 shell 里某个残留的 LLM_API_KEY（比如上一条命令 export 了
#     DeepSeek 的）会盖过 HUNYUAN_API_KEY，请求带着错 key 打到混元报 401，
#     而配置看上去完全正常。
# LLM_API_KEY=
# HUNYUAN_API_KEY=
# RELAY_API_KEY=
# DEEPSEEK_API_KEY=

# ── 本机 WorkBuddy（Hy3，档案 hy3）────────────────────────────
# ★ 不是云端 API key：Hy3 只认 WorkBuddy 桌面客户端的登录态，上游不发公网
#   key。所以走本机 sidecar（tools/wb_sidecar.mjs）复用桌面端登录，
#   把它转成标准 OpenAI 接口，本档案指向那个本地端口。
#
#   两步：
#     1) 起 sidecar：  node tools/wb_sidecar.mjs --port 8787
#        （token 随机生成并写进 .workbuddy-sidecar.json；也可 --token 固定，
#          或先 export WORKBUDDY_SIDECAR_TOKEN，sidecar 会直接用它）
#     2) 把同一个 token 填到下面这行，然后 LLM_PROFILE=hy3
#
#   ★ 两边的 token 必须一致，否则请求 401。sidecar 启动时会读本文件所在目录
#     的 .env，所以也可以只写这一行、让 sidecar 自己去读。
# WORKBUDDY_SIDECAR_TOKEN=

# ★ 单价（元 / 千 token）：**必须跟着端点一起改**。
#   成本轴用它换算金额。换模型不改这两行，报表的成本列就在说谎 ——
#   而它不会报错，数字量级也照常合理，只是"这次比上次便宜"这类结论
#   建立在两套单价上。（与缺陷 ⑨ 基准漂移同类：漂移源从时钟换成了单价表。）
#   内置档案已带官方价（deepseek 0.001/0.002、hunyuan 0.0005/0.002）。
#   中转站 / openai 档案**刻意留空** —— 不掌握当前价目时填错比留空更糟：
#   留空会让报表打"成本列不可用"的告警，填错则会让它安静地算错。
#
#   ★ 只想声明"这个端点多少钱"就用这两行（两条路径都认）；没声明时：
#     · 老路径 + 地址是某个内置端点 → 按地址认领那个档案的价（缺陷 ⑭）；
#     · 认不出来 → 判"未声明"，报表打告警，而不是套一个默认价。
# LLM_PRICE_IN_PER_1K_CNY=
# LLM_PRICE_OUT_PER_1K_CNY=

# ★ 逃生开关：默认 false。`eval` / `report` 在用 kind=llm 时会要求端点
#   已通过自检（`cli endpoint --check`），否则直接退出。
#   理由见 README"多端点"章：中转层丢 tool_calls 时**接口一切正常**
#   （HTTP 200、有内容、计费了），只是 agent 一步都走不动 ——
#   这种故障跑完一整轮才在准确率上显形，而那时钱已经花了。
# LLM_ALLOW_UNVERIFIED=false

# ── 数据层 ──
# 业务数据（合成/真实工单）。★ 建议留空 —— 默认落在 PROJECT_ROOT/eval_out/ticket_agent.db。
# 若要覆盖，注意本项目数据层是**同步** create_engine，URL 不能带 +aiosqlite：
# 写成 sqlite+aiosqlite:// 会在建引擎时直接抛
#   ImportError: The SQLAlchemy asyncio module requires that the Python 'greenlet'
#   library is installed ... 'pip install sqlalchemy[asyncio]'
# （这个坑曾经真的存在于本文件里，见 README §4.2 缺陷 ⑧。）
# DATABASE_URL=sqlite:///./eval_out/ticket_agent.db
# 图状态 checkpointer: memory | sqlite | postgres
# memory → 不持久化（评测必须用这个，见 README §4.2 缺陷 ⑧ 里"续跑旧状态"的坑）
# sqlite → 落盘到 eval_out/checkpoints.sqlite，需 pip install langgraph-checkpoint-sqlite
# postgres → 需 pip install -e ".[postgres]" 并填 POSTGRES_DSN
CHECKPOINTER=memory
POSTGRES_DSN=postgresql://ticket:ticket@localhost:5432/ticket_agent

# ── 预算与熔断（难点 #5）────────────────────────────────────
# 单个工单的 token 上限，超出即短路并升级人工
MAX_TOKENS_PER_TICKET=120000
# 单工单成本上限（元）
MAX_COST_PER_TICKET_CNY=1.50

# ★ 下面两行**默认注释掉，而且建议保持注释**（缺陷 ⑭）。
#   它们是老路径（没选 LLM_PROFILE）声明单价的字段。原先这两行是**未注释的
#   实际赋值** 0.001/0.002 —— 后果是 `cp .env.example .env` 之后，
#   老路径的单价被**显式钉死**成 DeepSeek 的价：把 OPENAI_BASE_URL /
#   LLM_BASE_URL 指到本地 ollama（边际成本 0）或混元（输入 0.0005）时，
#   报表仍按 0.001/0.002 算成本，并且 price_known=True，
#   那条"成本列不可用"的告警**永远不会响** —— 成本列安静地说谎。
#
#   现在的规则：单价必须与端点身份**来自同一个来源**。
#     ① 选档案（推荐）：单价跟着档案走，内置档案已带官方价；
#     ② 老路径但地址认得出是某个内置端点：按地址认领那个档案的价；
#     ③ 老路径且地址认不出：判"未声明" → 报表打告警（成本列不可用，不是免费）；
#     ④ 上面都不满意，就显式声明 —— 那才是下面这两行的用途。
#   要声明，**优先用 LLM_PRICE_IN/OUT_PER_1K_CNY**（见文件上半部分的说明，
#   两条路径都认）；下面这两行只在"老路径 + 显式填了"时才生效。
# PRICE_INPUT_PER_1K_CNY=
# PRICE_OUTPUT_PER_1K_CNY=

# ── 业务规则阈值（R4）──────────────────────────────────────
REFUND_HITL_THRESHOLD_CNY=500
RISK_SCORE_HITL_THRESHOLD=0.7
RETURN_WINDOW_DAYS=7

# ── 评测 ──
EVAL_OUT_DIR=./eval_out
EVAL_HOLDOUT_RATIO=0.3
EVAL_SEED=42

# ── 服务层 ──
API_HOST=127.0.0.1
API_PORT=8000
# 演示用租户 token → tenant_id 映射（生产替换为真实鉴权）
TENANT_TOKENS={"tok-acme":"acme","tok-globex":"globex"}

# ★ 这里曾经有 LOG_LEVEL=INFO，已删除：没有消费者。
#   可观测性走 AuditLog 表（见 README §4.3），不靠进程日志。
